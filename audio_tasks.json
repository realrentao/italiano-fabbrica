{
"id": "audio_0200",
"text": "Questi vanno scartati."
},
{
"id": "audio_0201",
"text": "Ho finito il taglio."
},
{
"id": "audio_0202",
"text": "Passami il tessuto."
},
{
"id": "audio_0203",
"text": "Quanti ne hai fatti?"
},
{
"id": "audio_0204",
"text": "Ne ho fatti duecento."
},
{
"id": "audio_0205",
"text": "Manca poco."
},
{
"id": "audio_0206",
"text": "Fai attenzione alle dita!"
},
{
"id": "audio_0207",
"text": "Spegni la luce, chiudiamo."
},
{
"id": "audio_0208",
"text": "A domani, colleghi!"
},
{
"id": "audio_0209",
"text": "Benvenuto in fabbrica!"
},
{
"id": "audio_0210",
"text": "Prego, si accomodi."
},
{
"id": "audio_0211",
"text": "Questo è il nostro reparto."
},
{
"id": "audio_0212",
"text": "Produciamo abbigliamento."
},
{
"id": "audio_0213",
"text": "Lavoriamo per conto terzi."
},
{
"id": "audio_0214",
"text": "Il minimo ordine è cinquecento pezzi."
},
{
"id": "audio_0215",
"text": "I prezzi sono molto competitivi."
},
{
"id": "audio_0216",
"text": "Possiamo fare il campione."
},
{
"id": "audio_0217",
"text": "La consegna è in due settimane."
},
{
"id": "audio_0218",
"text": "Le mostro il catalogo."
},
{
"id": "audio_0219",
"text": "Accettiamo bonifico o contanti."
},
{
"id": "audio_0220",
"text": "Faremo una fattura regolare."
},
{
"id": "audio_0221",
"text": "Grazie della visita!"
},
{
"id": "audio_0222",
"text": "Ci sentiamo per l’ordine."
},
{
"id": "audio_0223",
"text": "Quanti pezzi servono?"
},
{
"id": "audio_0224",
"text": "Quando è pronto?"
},
{
"id": "audio_0225",
"text": "È urgente."
},
{
"id": "audio_0226",
"text": "Va bene così."
},
{
"id": "audio_0227",
"text": "Non va bene."
},
{
"id": "audio_0228",
"text": "Devo rifare."
},
{
"id": "audio_0229",
"text": "Mi serve altro tessuto."
},
{
"id": "audio_0230",
"text": "La macchina non va."
},
{
"id": "audio_0231",
"text": "Fai attenzione."
},
{
"id": "audio_0232",
"text": "Ho finito."
},
{
"id": "audio_0233",
"text": "A che ora finiamo?"
},
{
"id": "audio_0234",
"text": "Posso fare una pausa?"
},
{
"id": "audio_0235",
"text": "Dove sono i guanti?"
},
{
"id": "audio_0236",
"text": "Mi dia il modello."
},
{
"id": "audio_0237",
"text": "Quanto costa al pezzo?"
},
{
"id": "audio_0238",
"text": "Grazie, a domani."
},
{
"id": "audio_0239",
"text": "Il contratto di lavoro è obbligatorio."
},
{
"id": "audio_0240",
"text": "La busta paga va conservata."
},
{
"id": "audio_0241",
"text": "La pausa pranzo è di un’ora."
},
{
"id": "audio_0242",
"text": "La sicurezza viene prima di tutto."
},
{
"id": "audio_0243",
"text": "Il permesso di soggiorno serve per lavorare."
},
{
"id": "audio_0244",
"text": "Lo stipendio si paga mensile."
},
{
"id": "audio_0245",
"text": "Le ferie sono un diritto."
},
{
"id": "audio_0246",
"text": "Le tredicesima è di dicembre."
},
{
"id": "audio_0247",
"text": "La firma sulle buste paga è importante."
},
{
"id": "audio_0248",
"text": "Contrattare il prezzo è raro."
},
{
"id": "audio_0249",
"text": "Cosa posso fare per lei?"
},
{
"id": "audio_0250",
"text": "Le mostro la nostra produzione."
},
{
"id": "audio_0251",
"text": "È il nostro prodotto più richiesto."
},
{
"id": "audio_0252",
"text": "Possiamo personalizzare."
},
{
"id": "audio_0253",
"text": "Ha il campione con sé?"
},
{
"id": "audio_0254",
"text": "Le preparo un preventivo."
},
{
"id": "audio_0255",
"text": "I tempi di consegna sono certi."
},
{
"id": "audio_0256",
"text": "Accettiamo ordinativi grandi."
},
{
"id": "audio_0257",
"text": "Le do il mio biglietto da visita."
},
{
"id": "audio_0258",
"text": "Resto a sua disposizione."
},
{
"id": "audio_0259",
"text": "Buona giornata!"
