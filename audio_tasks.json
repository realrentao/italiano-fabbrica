{
"id": "audio_0191",
"text": "Chiamo il tecnico."
},
{
"id": "audio_0192",
"text": "Questo punto è sbagliato."
},
{
"id": "audio_0193",
"text": "Devi rifare questo pezzo."
},
{
"id": "audio_0194",
"text": "C’è un buco qui."
},
{
"id": "audio_0195",
"text": "La cucitura è storta."
},
{
"id": "audio_0196",
"text": "Va bene così?"
