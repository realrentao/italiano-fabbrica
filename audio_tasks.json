{
"id": "audio_0183",
"text": "Quanti pezzi dobbiamo fare?"
},
{
"id": "audio_0184",
"text": "Oggi facciamo cinquecento capi."
},
{
"id": "audio_0185",
"text": "Quando è la consegna?"
},
{
"id": "audio_0186",
"text": "La spedizione è venerdì."
},
{
"id": "audio_0187",
"text": "Questo lotto è urgente."
},
{
"id": "audio_0188",
"text": "Rallentiamo un po’."
},
{
"id": "audio_0189",
"text": "Andiamo più veloci."
